  
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Helen Getnet's personal portfolio. Computer Science student, video editor, and graphic designer in Ethiopia.">
  <meta name="theme-color" content="#08080d">
  <meta property="og:title" content="Helen Getnet | Digital Creative">
  <meta property="og:description" content="Building digital experiences and creating visual stories.">
  <title>Helen Getnet | Digital Creative</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <script src="script.js" defer></script>
</head>

<body>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="header" id="top">
    <nav class="nav container" aria-label="Main navigation">
      <a href="#home" class="brand" aria-label="Helen Getnet home">
        <span class="brand-mark">H<span>E</span></span>
        <span>HELEN<span class="brand-dot">.</span></span>
      </a>

      <button class="menu-toggle" id="menu-toggle"
        aria-label="Open navigation" aria-expanded="false"
        aria-controls="nav-links">
        <span></span><span></span>
      </button>

      <div class="nav-links" id="nav-links">
        <a href="#home" class="nav-link active">Home</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#skills" class="nav-link">Skills</a>
        <a href="#projects" class="nav-link">Projects</a>
        <a href="#creative" class="nav-link">Creative Work</a>
        <a href="#education" class="nav-link">Education</a>
        <a href="#contact" class="nav-contact">Let's Talk <span>↗</span></a>
      </div>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero section container" id="home">
      <div class="hero-copy">
        <div class="eyebrow reveal">
          <span class="status-dot"></span>
          COMPUTER SCIENCE STUDENT & DIGITAL CREATIVE
        </div>

        <h1 class="hero-title reveal">
          I build digital<br>
          experiences<span class="purple">.</span><br>
          I create visual<br>
          <span class="outline-text">stories.</span>
        </h1>

        <p class="hero-description reveal">
          I'm <strong>Helen Getnet</strong>, a Computer Science student,
          video editor, and graphic designer exploring the space where
          technology meets creativity.
        </p>

        <div class="hero-actions reveal">
          <a class="button button-primary" href="#projects">
            Explore my work <span>↗</span>
          </a>
          <a class="button button-secondary" href="#contact">
            Let's connect <span>↗</span>
          </a>
        </div>

        <div class="hero-meta reveal">
          <span><span class="meta-symbol">⌖</span> Ethiopia</span>
          <span class="meta-divider"></span>
          <span>Learning. Creating. Building.</span>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-glow"></div>

        <div class="profile-frame">
          <img
            src="images/profile.jpg"
            alt="Portrait of Helen Getnet"
            class="profile-image"
            onerror="this.style.display='none';this.nextElementSibling.style.display='grid';"
          >
          <div class="profile-placeholder" style="display:none">
            <span>HE</span>
            <small>ADD YOUR PHOTO</small>
          </div>
          <div class="image-overlay"></div>
          <div class="image-caption">
            <span class="caption-line"></span>
            <span>DESIGNING MY OWN PATH</span>
          </div>
        </div>

        <div class="floating-card floating-card-top">
          <span class="card-icon">✳</span>
          <div><strong>Creative Mind</strong><small>Visual storytelling</small></div>
        </div>

        <div class="floating-card floating-card-bottom">
          <span class="code-icon">&lt;/&gt;</span>
          <div><strong>Tech Explorer</strong><small>Computer Science</small></div>
        </div>

        <span class="visual-index">01 / 06</span>
      </div>

      <a class="scroll-cue" href="#about">
        <span class="scroll-wheel"></span> SCROLL TO EXPLORE
      </a>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-label="My areas of interest">
      <div class="marquee-track">
        <span>CODE <i>✳</i></span>
        <span>DESIGN <i>✳</i></span>
        <span>EDIT <i>✳</i></span>
        <span>CREATE <i>✳</i></span>
        <span>INNOVATE <i>✳</i></span>
        <span>CODE <i>✳</i></span>
        <span>DESIGN <i>✳</i></span>
        <span>EDIT <i>✳</i></span>
        <span>CREATE <i>✳</i></span>
        <span>INNOVATE <i>✳</i></span>
      </div>
    </div>

    <!-- ABOUT -->
    <section class="section container" id="about">
      <div class="section-heading reveal">
        <span class="section-number">01 / ABOUT</span>
        <h2>A curious mind.<br>A <span class="purple">creative vision.</span></h2>
      </div>

      <div class="about-grid">
        <div class="about-visual reveal">
          <div class="about-image-wrap">
            <img src="images/profile.jpg" alt="Helen Getnet"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
            <div class="about-placeholder" style="display:none">HE</div>
          </div>
          <div class="about-stamp">CURIOUS<br>BY NATURE <span>✳</span></div>
        </div>

        <div class="about-copy reveal">
          <span class="eyebrow">A LITTLE ABOUT ME</span>
          <h3>Technology gives me the tools. Creativity gives them a voice.</h3>
          <p>
            I'm Helen, a Computer Science student at Wolaita Sodo University
            in Ethiopia. I enjoy learning how technology works and how
            thoughtful design can turn an idea into an experience.
          </p>
          <p>
            Beyond coding, I explore video editing and graphic design.
            These creative interests help me think about not only how
            something works, but also how it looks, feels, and communicates.
          </p>
          <p>
            My journey is still unfolding. I'm building my skills, exploring
            new ideas, and working toward a future in software development
            and digital creativity.
          </p>

          <div class="about-facts">
            <div><span class="fact-symbol">✳</span><span>Problem solving</span></div>
            <div><span class="fact-symbol">✳</span><span>Visual storytelling</span></div>
            <div><span class="fact-symbol">✳</span><span>Continuous learning</span></div>
          </div>

          <a href="#education" class="text-link">Explore my journey <span>↗</span></a>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section section-muted" id="skills">
      <div class="container">
        <div class="section-heading reveal">
          <span class="section-number">02 / WHAT I DO</span>
          <h2>Different skills.<br><span class="purple">One creative mind.</span></h2>
          <p class="section-intro">
            My interests connect the logic of technology with the freedom
            of visual creativity.
          </p>
        </div>

        <div class="skills-grid">
          <article class="skill-card reveal">
            <div class="skill-card-top"><span class="skill-icon">&lt;/&gt;</span><span>01</span></div>
            <h3>Web & Technology</h3>
            <p>Building my foundation in web development and software engineering.</p>
            <div class="skill-tags">
              <span>HTML</span><span>CSS</span><span>JavaScript</span>
              <span>Programming</span>
            </div>
            <div class="skill-card-line"></div>
          </article>

          <article class="skill-card reveal">
            <div class="skill-card-top"><span class="skill-icon">◈</span><span>02</span></div>
            <h3>Graphic Design</h3>
            <p>Exploring visual identity, composition, typography, and digital design.</p>
            <div class="skill-tags">
              <span>Visual Design</span><span>Typography</span>
              <span>Digital Graphics</span>
            </div>
            <div class="skill-card-line"></div>
          </article>

          <article class="skill-card reveal">
            <div class="skill-card-top"><span class="skill-icon">▶</span><span>03</span></div>
            <h3>Video Editing</h3>
            <p>Turning footage, sound, and timing into engaging visual stories.</p>
            <div class="skill-tags">
              <span>Editing</span><span>Storytelling</span><span>Content</span>
            </div>
            <div class="skill-card-line"></div>
          </article>
        </div>
        <p class="small-note reveal">
          Skills and tools will grow with my experience. Specific software
          proficiency can be added as I update this portfolio.
        </p>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="section container" id="projects">
      <div class="section-heading section-heading-row reveal">
        <div>
          <span class="section-number">03 / SELECTED PROJECTS</span>
          <h2>Ideas in <span class="purple">progress.</span></h2>
        </div>
        <p class="section-intro">A growing collection of things I've explored and built.</p>
      </div>

      <article class="project-card reveal">
        <div class="project-image">
          <img src="images/project-inventory.jpg"
            alt="Inventory and stock monitoring project preview"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
          <div class="project-placeholder" style="display:none">
            <span>INVENTORY<br><b>01</b></span>
          </div>
          <span class="project-badge">DATABASE PROJECT</span>
        </div>
        <div class="project-info">
          <span class="project-index">FEATURED PROJECT / 01</span>
          <h3>Inventory & Stock Monitoring System</h3>
          <p>
            A database-focused project concept for organizing product
            information, categories, suppliers, inventory records, and
            stock transactions.
          </p>
          <div class="skill-tags">
            <span>Database Design</span><span>ER Modeling</span><span>SQL</span>
          </div>
          <button class="text-link project-details"
            data-title="Inventory & Stock Monitoring System"
            data-description="A database-focused project concept designed to organize products, categories, suppliers, inventory records, and stock transactions. Add your actual ER diagram, screenshots, implementation details, and repository link as the project develops."
            type="button">View project details <span>↗</span></button>
        </div>
      </article>

      <div class="project-grid">
        <article class="mini-project reveal">
          <div class="mini-project-art art-purple"><span>WEB<br>EXPERIMENTS</span><b>02</b></div>
          <div class="mini-project-info">
            <span class="project-index">WEB DEVELOPMENT</span>
            <h3>Web Experiments</h3>
            <p>A space for future websites and frontend practice.</p>
            <span class="coming-soon">Add your project when ready</span>
          </div>
        </article>

        <article class="mini-project reveal">
          <div class="mini-project-art art-blue"><span>VISUAL<br>CONCEPTS</span><b>03</b></div>
          <div class="mini-project-info">
            <span class="project-index">DESIGN & MEDIA</span>
            <h3>Creative Experiments</h3>
            <p>A collection of graphic design and video editing work.</p>
            <a class="text-link" href="#creative">Explore gallery <span>↗</span></a>
          </div>
        </article>
      </div>
    </section>

    <!-- CREATIVE WORK -->
    <section class="section section-muted" id="creative">
      <div class="container">
        <div class="section-heading reveal">
          <span class="section-number">04 / THE CREATIVE SIDE</span>
          <h2>Frames, forms &<br><span class="purple">fresh perspectives.</span></h2>
          <p class="section-intro">
            A dedicated space for my visual work. Replace these panels with
            your actual designs, posters, and video thumbnails.
          </p>
        </div>

        <div class="creative-grid">
          <button class="creative-item creative-large reveal"
            type="button" data-title="Graphic Design" data-image="images/design-1.jpg">
            <img src="images/design-1.jpg" alt="Graphic design portfolio piece"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
            <span class="creative-fallback" style="display:none">DESIGN<br>STUDIO</span>
            <span class="creative-overlay"><span>01 / GRAPHIC DESIGN</span><b>Visual identity <i>↗</i></b></span>
          </button>

          <button class="creative-item reveal"
            type="button" data-title="Digital Design" data-image="images/design-2.jpg">
            <img src="images/design-2.jpg" alt="Digital design portfolio piece" loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
            <span class="creative-fallback fallback-blue" style="display:none">DIGITAL<br>ART</span>
            <span class="creative-overlay"><span>02 / DIGITAL ART</span><b>Digital design <i>↗</i></b></span>
          </button>

          <button class="creative-item reveal"
            type="button" data-title="Video Editing" data-image="images/video-thumbnail-1.jpg">
            <img src="images/video-thumbnail-1.jpg" alt="Video editing project thumbnail" loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='grid';">
            <span class="creative-fallback fallback-pink" style="display:none">VIDEO<br>STORIES</span>
            <span class="creative-overlay"><span>03 / VIDEO EDITING</span><b>Motion & story <i>↗</i></b></span>
          </button>
        </div>
        <p class="small-note">These are placeholders until you add your own work. Your portfolio should showcase your actual creations.</p>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="section container" id="education">
      <div class="section-heading reveal">
        <span class="section-number">05 / MY JOURNEY</span>
        <h2>Learning is a <span class="purple">lifelong project.</span></h2>
      </div>

      <div class="timeline">
        <article class="timeline-item reveal">
          <div class="timeline-marker"></div>
          <div class="timeline-date">CURRENTLY STUDYING</div>
          <div class="timeline-content">
            <span class="timeline-type">UNIVERSITY EDUCATION</span>
            <h3>Wolaita Sodo University</h3>
            <p>Computer Science</p>
            <p class="muted-text">
              Developing my understanding of programming, computing,
              software, and problem solving.
            </p>
          </div>
          <span class="timeline-number">01</span>
        </article>

        <article class="timeline-item reveal">
          <div class="timeline-marker"></div>
          <div class="timeline-date">COMPLETED</div>
          <div class="timeline-content">
            <span class="timeline-type">ADDITIONAL EDUCATION</span>
            <h3>Global Language School</h3>
            <p>Graduate</p>
            <p class="muted-text">
              An additional part of my educational journey.
            </p>
          </div>
          <span class="timeline-number">02</span>
        </article>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact-section" id="contact">
      <div class="container">
        <div class="contact-heading reveal">
          <span class="section-number">06 / GET IN TOUCH</span>
          <h2>Let's make something<br><span class="purple">worth remembering.</span></h2>
          <p>Have a project idea, a creative collaboration, or a friendly hello in mind? Send me a message.</p>
        </div>

        <div class="contact-grid">
          <div class="contact-details reveal">
            <span class="eyebrow">CONTACT INFORMATION</span>
            <h3>Start a conversation.</h3>
            <p class="muted-text">
              Replace the sample email and social links with your real details.
            </p>

            <a class="contact-method" href="mailto:YOUR_EMAIL@example.com">
              <span class="contact-method-icon">✉</span>
              <span><small>EMAIL ME</small><strong>YOUR_EMAIL@example.com</strong></span>
              <span class="contact-arrow">↗</span>
            </a>

            <a class="contact-method" href="https://github.com/" target="_blank" rel="noopener noreferrer">
              <span class="contact-method-icon">⌘</span>
              <span><small>GITHUB</small><strong>Explore my code</strong></span>
              <span class="contact-arrow">↗</span>
            </a>

            <a class="contact-method" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
              <span class="contact-method-icon">in</span>
              <span><small>LINKEDIN</small><strong>Connect professionally</strong></span>
              <span class="contact-arrow">↗</span>
            </a>
          </div>

          <form class="contact-form reveal" id="contact-form">
            <div class="form-row">
              <label for="name">Your name
                <input type="text" id="name" name="name" placeholder="Your name" required>
              </label>
              <label for="email">Your email
                <input type="email" id="email" name="email" placeholder="you@example.com" required>
              </label>
            </div>
            <label for="subject">Subject
              <input type="text" id="subject" name="subject" placeholder="What would you like to discuss?" required>
            </label>
            <label for="message">Your message
              <textarea id="message" name="message" rows="5" placeholder="Tell me about your idea..." required></textarea>
            </label>
            <button class="button button-primary form-submit" type="submit">
              Prepare email <span>↗</span>
            </button>
            <p class="form-status" id="form-status" role="status" aria-live="polite">
              This demo prepares an email in your email application. It does not send messages directly.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner">
      <a href="#home" class="brand">
        <span class="brand-mark">H<span>E</span></span>
        <span>HELEN<span class="brand-dot">.</span></span>
      </a>
      <p>Curiosity in code. Creativity in every frame.</p>
      <a href="#top" class="back-top">BACK TO TOP ↑</a>
      <span class="copyright">© <span id="year"></span> Helen Getnet</span>
    </div>
  </footer>

  <!-- PROJECT / IMAGE PREVIEW -->
  <dialog class="preview-dialog" id="preview-dialog" aria-labelledby="preview-title">
    <button class="preview-close" id="preview-close" aria-label="Close preview">×</button>
    <img id="preview-image" src="" alt="" hidden>
    <div class="preview-image-placeholder" id="preview-image-placeholder" hidden>CREATIVE WORK</div>
    <span class="section-number">PORTFOLIO PREVIEW</span>
    <h2 id="preview-title">Project title</h2>
    <p id="preview-description"></p>
  </dialog>
</body>
</html>
